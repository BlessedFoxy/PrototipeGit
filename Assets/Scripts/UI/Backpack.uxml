<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- КНОПКА-РУЧКА (всегда видна) -->
    <ui:VisualElement name="handle" style="
        position: absolute;
        bottom: 0;
        left: 50%;
        translate: -50% 0;
        width: 80px;
        height: 36px;
        background-color: rgba(60, 60, 80, 0.9);
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.1);
    ">
        <ui:Label text="▲" style="font-size: 20px; color: rgba(255,255,255,0.7); -unity-text-align: middle-center;"/>
    </ui:VisualElement>
    
    <!-- ПАНЕЛЬ ИНВЕНТАРЯ -->
    <ui:VisualElement name="backpack-panel" style="
        position: absolute;
        bottom: -500px;
        left: 10%;
        right: 10%;
        width: 80%;
        height: 420px;
        background-color: rgba(20, 20, 30, 0.96);
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        padding: 20px 20px 10px 20px;
        border: 1px solid rgba(255,255,255,0.05);
    ">
        <!-- ЗАГОЛОВОК -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <ui:Label text="🎒 ИНВЕНТАРЬ" style="font-size: 22px; color: white; -unity-text-align: middle-left;"/>
            <ui:Label name="close-btn" text="▼" style="font-size: 28px; color: rgba(255,255,255,0.5); cursor: pointer; padding: 0 12px;"/>
        </ui:VisualElement>
        
        <!-- СЕТКА ЯЧЕЕК -->
        <ui:VisualElement name="grid-container" style="
            flex-direction: row;
            flex-wrap: wrap;
            align-content: flex-start;
            padding: 8px;
            background-color: rgba(0,0,0,0.3);
            border-radius: 12px;
            flex-grow: 1;
        "/>
        
        <!-- ПОДСКАЗКА -->
        <ui:Label style="
            font-size: 14px;
            color: rgba(255,255,255,0.25);
            -unity-text-align: middle-center;
            margin-top: 8px;
            padding: 4px;
        " text="Свайпните вниз или нажмите ▼ чтобы закрыть"/>
    </ui:VisualElement>
</ui:UXML>